{
  "name": "dsh-browser-control",
  "version": "0.1.0",
  "description": "DSH Desktop 内置插件：把主进程的「GUI 内嵌浏览器 Dock」以 mcp__browser__* 工具暴露给对话 agent，支持导航/点击/输入/截图/读快照；前端提供一个「浏览器」开关按钮显示/隐藏该 Dock。纯 JS 零构建。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0-rc.7",
    "@deepseek-ai/dsh-mcp-client": "^1.0.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "browser",
    "mcp"
  ],
  "license": "MIT"
}