{
  "name": "dsh-conversation-tools",
  "version": "0.1.0",
  "description": "DSH Desktop 内置插件：对话区便捷工具——「精简历史」一键触发 /compact 压缩历史对话；「定位工作区文件夹」列出所有工作区并在本地文件资源管理器中定位/打开。纯 JS 零构建。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0-rc.7"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "conversation",
    "compact",
    "workspace"
  ],
  "license": "MIT"
}