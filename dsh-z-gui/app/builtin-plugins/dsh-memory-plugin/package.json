{
  "name": "dsh-memory-plugin",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) 插件：为 Agent 增加永久记忆（跨会话事实+对话摘要）与本地 RAG（后续阶段）能力，全本地离线。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "build:esm": "esbuild src/index.ts --bundle --platform=node --format=esm --external:@deepseek-ai/cordis --external:@deepseek-ai/schemastery --external:@deepseek-ai/dsh-session --external:@deepseek-ai/dsh-llm --external:@deepseek-ai/dsh-settings --external:@xenova/transformers --outfile=lib/index.js"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "memory",
    "rag"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0-rc.7",
    "@deepseek-ai/dsh-llm": "^1.0.0",
    "@deepseek-ai/dsh-session": "^1.0.0",
    "@deepseek-ai/dsh-settings": "^1.0.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
