{
  "name": "dsh-desktop-frame",
  "version": "0.1.0",
  "description": "DSH Desktop 内置插件：在 dsh web 页面渲染官方同款桌面标题栏（extended/advanced 呈现模式）——身份区（产品名/版本/模式切换）+ 动作区（终端/重启/开发者工具），动作经 preload IPC 送达主进程。纯 JS 零构建。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0-rc.7"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "desktop",
    "frame"
  ],
  "license": "MIT"
}
