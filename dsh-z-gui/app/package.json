{
  "name": "dsh-gui",
  "productName": "DSH Desktop",
  "version": "0.1.0",
  "description": "DeepSeek Harness 桌面版：内置 Node 运行时的 Electron 壳，开箱即用，无需安装 Node 或任何运行时。",
  "main": "main/index.js",
  "author": "dsh",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder",
    "pack:win": "electron-builder --win --x64",
    "pack:linux": "electron-builder --linux --x64"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  }
}
